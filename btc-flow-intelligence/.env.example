# ============ BTC Flow Intelligence — environment ============
# Copy to .env (backend) and fill in what you have. Everything works in
# MOCK_MODE without any keys; adapters auto-fall back to mock when a key
# is missing, so you can enable sources one at a time.

# --- Core ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# When true, NO live HTTP calls are made; all sources serve realistic mock data.
MOCK_MODE=true
RUN_ON_STARTUP=true

# --- Database (Railway injects DATABASE_URL automatically) ---
DATABASE_URL=postgresql://btc:btc@localhost:5432/btcflow

# --- Scheduler ---
REFRESH_INTERVAL_MINUTES=60

# --- CORS (comma-separated; omit/`*` for all) ---
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Data source API keys (optional; missing key => that source uses mock) ---
COINGLASS_API_KEY=
CRYPTOQUANT_API_KEY=
SOSOVALUE_API_KEY=
ARKHAM_API_KEY=
GLASSNODE_API_KEY=
KAIKO_API_KEY=
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=

# --- Alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_ON_VERDICT_CHANGE=true

# ============ Frontend ============
# Set on the FRONTEND service. Server-side rewrites /api/* to this target.
BACKEND_URL=http://localhost:8000
