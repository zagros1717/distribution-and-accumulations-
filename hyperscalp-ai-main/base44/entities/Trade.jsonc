{
  "name": "Trade",
  "type": "object",
  "properties": {
    "coin": { "type": "string" },
    "strategy": {
      "type": "string",
      "enum": ["range_mr", "trend_breakout", "liquidation_fade"],
      "description": "Which strategy fired this trade. Drives strategy-state attribution + bandit allocator."
    },
    "direction": { "type": "string", "enum": ["long", "short"] },
    "entry_price": { "type": "number" },
    "exit_price": { "type": "number" },
    "tp_price": { "type": "number", "description": "Take profit price" },
    "sl_price": { "type": "number", "description": "Stop loss price" },
    "atr_value": { "type": "number", "description": "ATR(1m) value at entry — used by trail" },
    "size_usd": { "type": "number" },
    "pnl": { "type": "number" },
    "pnl_pct": { "type": "number" },
    "status": { "type": "string", "enum": ["open", "closed", "cancelled"], "default": "open" },
    "signal_reason": { "type": "string" },
    "imbalance_ratio": { "type": "number" },
    "opened_at": { "type": "string", "format": "date-time" },
    "closed_at": { "type": "string", "format": "date-time" },
    "partial_tp_r": { "type": "number", "description": "R-multiple at which to take partial profit" },
    "partial_tp_fraction": { "type": "number", "description": "Fraction of position to close at partial TP" },
    "partial_tp_done": { "type": "boolean", "default": false },
    "trail_type": { "type": "string", "enum": ["none", "chandelier"], "default": "none" },
    "trail_atr_mult": { "type": "number", "default": 0 },
    "tp_oid": { "type": "number", "description": "Hyperliquid OID of the TP trigger order" },
    "sl_oid": { "type": "number", "description": "Hyperliquid OID of the SL trigger order" }
  },
  "required": ["coin", "direction", "entry_price", "size_usd"]
}
